# Copy to .env and fill in. Never commit .env.

# AES-256 key for the credential vault. Generate: openssl rand -base64 32. Losing it loses every credential.
SYSADM_MASTER_KEY=

# The internal token and the opencode password are generated by SysAiAdm Station on every start; they are not configured here.

SYSADM_HTTPS_PORT=443
SYSADM_DOMAIN=localhost
SYSADM_TLS=internal

# Log level: debug | info | warn | error. Default info. debug records every HTTP request.
# LOG_LEVEL=debug|info|warn|error

# Optional: GitHub token for installing skills from GitHub (raises the API rate limit, gives access to private repos).
# GITHUB_TOKEN=

# ONLY for the test stand: disables the TOTP code check. The password still applies. Never set on prod.
# SYSADM_ENV=dev
