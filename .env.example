# Copy to .env and fill in. Never commit .env.

# AES-256 key for the credential vault. Generate: openssl rand -base64 32. Losing it loses every credential.
SYSADM_MASTER_KEY=

# The internal token and the opencode password are generated by sysadm on every start; they are not configured here.

SYSADM_HTTPS_PORT=443
SYSADM_DOMAIN=localhost
SYSADM_TLS=internal
