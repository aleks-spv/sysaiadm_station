# Copy to .env and fill in. Never commit .env.

# AES-256 key for the credential vault. Generate: openssl rand -base64 32. Losing it loses every credential.
SYSADM_MASTER_KEY=

# Shared secret between sysadm (:3001) and the opencode plugin. Generate: openssl rand -hex 32
SYSADM_INTERNAL_TOKEN=

# Password for `opencode serve`: the server reads it from this variable and clients send it as HTTP Basic
# with username "opencode". Generate: openssl rand -hex 24
OPENCODE_SERVER_PASSWORD=

SYSADM_HTTPS_PORT=443
SYSADM_DOMAIN=localhost
SYSADM_TLS=internal
