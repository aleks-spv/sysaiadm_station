{
  "name": "sysadm",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test apps/server packages",
    "typecheck": "tsc --noEmit -p . && bun run --filter @sysadm/web typecheck"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^5.6.0"
  }
}
